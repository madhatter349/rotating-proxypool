# ===== Server =====
# HTTP port for the dashboard + management API
PORT=8080
# Raw TCP port for the authenticated forward-proxy gateway (CONNECT tunneling)
PROXY_PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# ===== PostgreSQL =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/proxypool

# ===== Gateway authentication (REQUIRED in production) =====
GATEWAY_USERNAME=proxyuser
GATEWAY_PASSWORD=change-me-strong-password
# Fail closed: reject proxy requests when auth is not configured
GATEWAY_AUTH_REQUIRED=true

# ===== Admin API =====
# Bearer token required for all /api/* endpoints
ADMIN_TOKEN=change-me-admin-token

# ===== Public connection metadata (served by /api-meta, NO secrets) =====
# Shown on the docs site so visitors see the real connection details.
# PUBLIC_PROXY_HOST=proxy.example.com
# PUBLIC_PROXY_PORT=8081
# PUBLIC_API_URL=https://your-dashboard.example.com

# ===== Gateway timeouts (ms) =====
# Max time to (re)connect to an upstream proxy host or complete its handshake.
CONNECT_TIMEOUT_MS=3000
# Total budget for a single client request through the gateway (connect+retries+tunnel).
GATEWAY_REQUEST_TIMEOUT_MS=120000
# Max time after a tunnel is established before the first origin byte arrives.
# Abandons a proxy that accepts CONNECT then stops forwarding (prevents 30s stalls).
TUNNEL_FIRST_BYTE_TIMEOUT_MS=8000
# Max silence mid-stream over an established tunnel before abandoning it.
# Keep below typical client read timeouts so stalled proxies are penalized first.
TUNNEL_IDLE_TIMEOUT_MS=8000
# After a gateway attempt fails for a proxy, keep it out of rotation this long.
GATEWAY_FAILURE_COOLDOWN_MS=30000
# Stop routing to proxies whose last real success is older than this (ms). Keeps
# user traffic off stale-healthy rows; a successful recheck refreshes last_success.
GATEWAY_MAX_LAST_SUCCESS_AGE_MS=900000
# Proxies measured slower than this (ms) are excluded from gateway rotation.
GATEWAY_MAX_LATENCY_MS=2500

# ===== Selection quality (production evidence) =====
# Proxy with last real gateway success within this window is "hot" and preferred.
HOT_SUCCESS_WINDOW_MS=600000
# Horizon over which past production success fully decays (stale evidence loses pull).
PROD_QUALITY_DECAY_MS=1800000
# Fraction of weight removed per recent real gateway failure (hard de-weight).
GATEWAY_FAILURE_PENALTY=0.5
# Fraction of gateway selections that explore the wider healthy pool (diversity/discovery).
GATEWAY_EXPLORATION_FRACTION=0.05
# Min real-gateway attempts on a source before its success rate may influence selection.
SOURCE_CONFIDENCE_MIN=8

# ===== Validation =====
# Comma-separated HTTPS targets used to prove real HTTPS traffic works through a proxy.
# A target may carry a body-marker: "https://host/path|marker" requires the response
# body to contain `marker`, which rejects TLS-interception (MITM) proxies that serve
# the wrong content. The service prepends its own open /api/validate IP-echo target
# (marker 'rotating-proxypool-validate') so the pool is filtered against a
# self-hosted endpoint that returns the exit IP, WITHOUT calling a third party.
VALIDATION_TARGETS=https://api.ipify.org,https://httpbin.org/ip
# Per-source-IP request cap on the public /api/validate endpoint (per minute).
VALIDATE_RATE_LIMIT_PER_MIN=120
# Bounded validation concurrency (never unbounded)
VALIDATION_CONCURRENCY=40
VALIDATION_TIMEOUT_MS=8000

# ===== Scheduling (ms) =====
DISCOVERY_INTERVAL_MS=3600000
VALIDATE_NEW_INTERVAL_MS=30000
RECHECK_INTERVAL_MS=60000
QUARANTINE_RETEST_INTERVAL_MS=120000
CLEANUP_INTERVAL_MS=900000

# ===== Quarantine / lifecycle =====
CONSECUTIVE_FAILURES_TO_QUARANTINE=3
QUARANTINE_MS=1800000
MIN_HEALTHY_SCORE=25
MAX_STALE_AGE_MS=86400000
VALIDATION_FAILURES_TO_DEAD=3
VALIDATE_NEW_MAX_BATCH=3000
RECHECK_MAX_BATCH=400

# ===== Sources =====
SOURCE_FETCH_TIMEOUT_MS=20000
SOURCE_MAX_BYTES=5242880
# Max candidates ingested per source per refresh (huge scraped lists are mostly dead).
SOURCE_MAX_CANDIDATES=2000
